{
  "manifest_version": 3,
  "name": "Sakura Sohbet Bahçesi",
  "short_name": "Sakura Sohbet",
  "version": "1.0.0",
  "description": "claude.ai sohbetlerinde harcanan tokenları tahmin eder, Sakura Token Bahçesi'ndeki Ume ağacını büyütür. Veri yalnızca bilgisayarındaki uygulamaya gider.",
  "author": "Hüseyin Cem Sallan",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Sakura Sohbet Bahçesi",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["meter.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
