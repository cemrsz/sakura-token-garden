{
  "name": "sakura-token-garden",
  "version": "1.2.0",
  "description": "Claude, Claude Code ve Codex token harcadıkça yavaşça büyüyen ağaçlar: Claude Code için Sakura, Claude sohbetleri için Ume, Codex için Momiji. Masaüstü uygulaması + tarayıcı sürümü + tarayıcı eklentisi.",
  "private": true,
  "license": "MIT",
  "main": "desktop/main.js",
  "bin": {
    "sakura-garden": "server.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "app": "electron .",
    "app:demo": "electron . --demo",
    "start": "node server.js --open",
    "serve": "node server.js",
    "widget": "node server.js --widget",
    "demo": "node server.js --demo --open --port 4880",
    "icons": "electron desktop/make-icons.js",
    "dist": "electron-builder --win",
    "test": "node --test test/parsers.test.js test/garden.test.js test/db.test.js test/tracker.test.js test/vscode-counter.test.js test/vscode-extension.test.js test/server.test.js test/browser-extension.test.js",
    "test:vscode": "node test/vscode-real/run.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "author": "Hüseyin Cem Sallan",
  "build": {
    "appId": "com.sakura.tokengarden",
    "productName": "Sakura Token Bahcesi",
    "copyright": "Hüseyin Cem Sallan",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "lib/**",
      "public/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sakura Token Bahçesi",
      "artifactName": "SakuraTokenBahcesi-Kurulum-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SakuraTokenBahcesi-${version}-portable.${ext}"
    }
  }
}
